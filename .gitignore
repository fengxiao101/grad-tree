# Dependencies and build output
node_modules/
dist/

# Local environment
.env
.env.local

# OS / editor noise
.DS_Store
*.log

# Claude Code local state. The agent definitions under .claude/agents/ are part
# of the documented program-encoding pipeline and are intentionally tracked.
.claude/*
!.claude/agents/

# Scraped bulletin PDFs, raw text, and per-program cache JSON. These are working
# artifacts of the encoding pipeline, regenerated on demand, and far too large
# (and of uncertain redistribution status) to belong in the repository.
# The mistakes log is hand-written pipeline documentation, not a scrape, and
# every encoding agent is required to read it, so it is tracked.
course_sheets/*
!course_sheets/encoding-mistakes.md

# Generated by scripts/pipeline.js
scripts/output/
